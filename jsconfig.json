{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2024",
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "checkJs": true,
        "experimentalDecorators": true,
        "strictNullChecks": false,
        "strictFunctionTypes": true,
        "strict": true,
        "javascript.implicitProjectConfig.checkJs": true
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}